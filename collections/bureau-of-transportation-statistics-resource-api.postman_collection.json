      "item": [
        {
          "id": "28b8ad7a-9181-4abb-a60f-9eb6fa964444",
          "name": "Query a BTS dataset using SoQL",
          "request": {
            "name": "Query a BTS dataset using SoQL",
            "description": {
              "content": "Retrieve rows from a BTS dataset. Supports SoQL (Socrata Query\nLanguage) parameters for filtering, projection, ordering, and\npagination. Replace `{datasetId}` with the dataset's four-by-four\nidentifier as listed at https://data.bts.gov/browse.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "resource",
                "{{datasetId}}.json"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "$select",
                  "value": "<string>",
                  "description": "Comma-separated list of columns to return."
                },
                {
                  "disabled": false,
                  "key": "$where",
                  "value": "<string>",
                  "description": "SoQL filter expression."
                },
                {
                  "disabled": false,
                  "key": "$order",
                  "value": "<string>",
                  "description": "Sort order, e.g. `column ASC`."
                },
                {
                  "disabled": false,
                  "key": "$group",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "$having",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "$limit",
                  "value": "1000",
                  "description": "Maximum number of rows to return (default 1000, max 50000)."
                },
                {
                  "disabled": false,
                  "key": "$offset",
                  "value": "0"
                },
                {
                  "disabled": false,
                  "key": "$q",
                  "value": "<string>",
                  "description": "Full-text search across the dataset."
                },
                {
                  "disabled": false,
                  "key": "$$app_token",
                  "value": "<string>",
                  "description": "Optional app token as a query parameter."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
